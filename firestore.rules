rules_version = '2';

// Publish this file in: Firebase console → Firestore Database → Rules → Publish.
//
//   courses/{courseId}               shared catalogue: any signed-in user can read and add courses
//   users/{uid}                      settings,       private to that user
//   users/{uid}/rounds/{roundId}     rounds,         private to that user
//   users/{uid}/myCourses/{courseId} course list and personal rating/slope, private to that user
//   users/{uid}/game/{docId}         Handi Golf stats, settings, profile and sharing choices, private to that user
//   sharedStats/{uid}                what a player chooses to show friends (handicap, recent rounds, game
//                                    stats); written by the owner, readable by the owner and accepted friends
//   friendCodes/{code}               code -> { uid, name }; readable only by exact code (no listing)
//   friendships/{uidA_uidB}          friend requests and friendships, visible to the two people
//   dailyScores/{date_uid}           one Daily result per player per day, create-only; readable by
//                                    the owner and accepted friends
//   dailyStats/{date}                per-day score histogram for the global percentile
//
// Anything not listed below is denied.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validRating(value) {
      return value is number && value >= 50 && value <= 90;
    }

    function validSlope(value) {
      return value is number && value >= 55 && value <= 155;
    }

    // Either no rating/slope at all, or a valid pair.
    function validValues(data) {
      return (!('rating' in data) && !('slope' in data))
        || (('rating' in data) && ('slope' in data) && validRating(data.rating) && validSlope(data.slope));
    }

    function validSettings(data) {
      return data.keys().hasOnly(['useCourseRatings', 'useCustomSelection', 'customBestCount', 'customWindowCount'])
        && data.keys().hasAll(['useCourseRatings', 'useCustomSelection', 'customBestCount', 'customWindowCount'])
        && data.useCourseRatings is bool
        && data.useCustomSelection is bool
        && data.customBestCount is int
        && data.customWindowCount is int
        && data.customBestCount >= 1
        && data.customWindowCount <= 20
        && data.customBestCount <= data.customWindowCount;
    }

    function validRound(data) {
      return data.keys().hasOnly(['date', 'courseId', 'score', 'par', 'qualifying', 'notes'])
        && data.keys().hasAll(['date', 'courseId', 'score', 'par', 'qualifying', 'notes'])
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.courseId is string
        && data.courseId.size() > 0
        && data.courseId.size() <= 200
        && data.score is number
        && data.score > 0
        && data.score <= 999
        && data.par is number
        && data.par > 0
        && data.par <= 200
        && data.qualifying is bool
        && data.notes is string
        && data.notes.size() <= 500;
    }

    // ---- HANDI Golf helpers ---------------------------------------------------

    // Friendship document ids are the two uids, sorted, joined with an underscore.
    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function friendshipPath(other) {
      return /databases/$(database)/documents/friendships/$(pairId(request.auth.uid, other));
    }

    function areFriends(other) {
      return signedIn()
        && exists(friendshipPath(other))
        && get(friendshipPath(other)).data.status == 'accepted';
    }

    function validName(name) {
      return name is string && name.size() >= 1 && name.size() <= 24;
    }

    function validHole(h) {
      return h is map
        && h.keys().hasOnly(['strokes', 'putts', 'penalties', 'shots'])
        && h.keys().hasAll(['strokes', 'putts', 'penalties', 'shots'])
        && h.strokes is int && h.strokes >= 1 && h.strokes <= 12
        && h.putts is int && h.putts >= 0 && h.putts <= 3
        && h.penalties is int && h.penalties >= 0 && h.penalties <= 12
        && h.shots is list && h.shots.size() <= 12;
    }

    function validScore(d) {
      return d.keys().hasOnly(['date', 'uid', 'name', 'genVersion', 'holes', 'total', 'penalties', 'createdAt'])
        && d.keys().hasAll(['date', 'uid', 'name', 'genVersion', 'holes', 'total', 'penalties', 'createdAt'])
        && d.uid == request.auth.uid
        && d.date is string
        && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && validName(d.name)
        && d.genVersion is int && d.genVersion >= 1
        && d.createdAt == request.time
        && d.holes is list && d.holes.size() == 3
        && validHole(d.holes[0]) && validHole(d.holes[1]) && validHole(d.holes[2])
        && d.total is int
        && d.total == d.holes[0].strokes + d.holes[1].strokes + d.holes[2].strokes
        && d.penalties is int && d.penalties >= 0 && d.penalties <= 36;
    }

    // The signed-in player's Daily result for a date, as it will be after this write.
    function myScorePath(date) {
      return /databases/$(database)/documents/dailyScores/$(date + '_' + request.auth.uid);
    }

    // A dailyStats write is only valid in the same batch as the writer's own brand-new result.
    function statsWriteOk(date) {
      return signedIn()
        && !exists(myScorePath(date))
        && existsAfter(myScorePath(date))
        && getAfter(myScorePath(date)).data.date == date;
    }

    function statsKey(date) {
      return 'b' + string(getAfter(myScorePath(date)).data.total);
    }

    // ---- Shared profile summary -----------------------------------------------
    //
    // Firestore stops evaluating a request after 1000 expressions, and a summary with five recent
    // rounds is close to that, so these checks stick to what matters: a fixed set of keys, the
    // right types and sane sizes. Only the owner can write this document, and it is only ever
    // shown through escaped text, so tight numeric ranges would add cost without adding safety.

    function validBest(b) {
      return b is map
        && b.keys().hasOnly(['over', 'score', 'par', 'date', 'course'])
        && b.over is number && b.score is number && b.par is number
        && b.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && b.course is string && b.course.size() <= 80;
    }

    function validRecentRound(r) {
      return r is map
        && r.keys().hasOnly(['date', 'course', 'score', 'par', 'q'])
        && r.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && r.course is string && r.course.size() <= 80
        && r.score is number && r.par is number && r.q is bool;
    }

    function validRecent(items) {
      return items is list
        && items.size() >= 1 && items.size() <= 5
        && validRecentRound(items[0])
        && (items.size() < 2 || validRecentRound(items[1]))
        && (items.size() < 3 || validRecentRound(items[2]))
        && (items.size() < 4 || validRecentRound(items[3]))
        && (items.size() < 5 || validRecentRound(items[4]));
    }

    function validGame(g) {
      return g is map
        && g.keys().size() >= 1
        && g.keys().hasOnly(['holes', 'avgVsPar', 'bestStreak', 'birdies', 'eagles', 'holesInOne',
                             'dailyStreak', 'dailyBest', 'dailyLast'])
        && (!('holes' in g) || g.holes is int)
        && (!('avgVsPar' in g) || g.avgVsPar is number)
        && (!('bestStreak' in g) || g.bestStreak is int)
        && (!('birdies' in g) || g.birdies is int)
        && (!('eagles' in g) || g.eagles is int)
        && (!('holesInOne' in g) || g.holesInOne is int)
        && (!('dailyStreak' in g) || g.dailyStreak is int)
        && (!('dailyBest' in g) || g.dailyBest is int)
        && (!('dailyLast' in g) || g.dailyLast.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function validShared(d) {
      return d.keys().hasOnly(['name', 'handicap', 'mode', 'roundsCount', 'qualifyingCount', 'best',
                               'recent', 'game', 'updatedAt'])
        && d.keys().hasAll(['name', 'updatedAt'])
        && validName(d.name)
        && d.updatedAt == request.time
        && (('handicap' in d) == ('mode' in d))
        && (!('handicap' in d) || (d.handicap is number && d.mode in ['overPar', 'differential']))
        && (('roundsCount' in d) == ('qualifyingCount' in d))
        && (!('roundsCount' in d) || (d.roundsCount is int && d.qualifyingCount is int))
        && (!('best' in d) || validBest(d.best))
        && (!('recent' in d) || validRecent(d.recent))
        && (!('game' in d) || validGame(d.game));
    }

    // Shared course catalogue.
    // - Anyone signed in can add a course (once: the document id is derived from the name).
    // - Values can be added later only while the course has none; after that they are fixed,
    //   and anyone who disagrees stores their own values in users/{uid}/myCourses instead.
    // - Courses are never deleted, because other users' rounds point at them.
    match /courses/{courseId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'createdBy', 'createdAt', 'rating', 'slope'])
        && request.resource.data.keys().hasAll(['name', 'createdBy', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && validValues(request.resource.data);

      allow update: if signedIn()
        && !('rating' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'slope'])
        && validValues(request.resource.data);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validSettings(request.resource.data);
      allow delete: if isOwner(uid);

      match /rounds/{roundId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validRound(request.resource.data);
      }

      match /game/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && docId in ['lifetime', 'settings', 'profile', 'privacy']
          && request.resource.data.keys().size() <= 40;
      }

      match /myCourses/{courseId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['rating', 'slope'])
          && validValues(request.resource.data);
      }
    }

    // Friend codes: how players find each other. Looked up by exact code only, never listed.
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && code.matches('^[A-Z0-9]{8}$')
        && request.resource.data.keys().hasOnly(['uid', 'name'])
        && request.resource.data.uid == request.auth.uid
        && validName(request.resource.data.name);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name'])
        && request.resource.data.uid == request.auth.uid
        && validName(request.resource.data.name);
      // Deleting your account releases your code.
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Search directory. Only names are public to signed-in players.
    match /playerDirectory/{ownerUid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 20;
      allow create, update: if isOwner(ownerUid)
        && request.resource.data.keys().hasOnly(['name', 'nameLower'])
        && request.resource.data.keys().hasAll(['name', 'nameLower'])
        && validName(request.resource.data.name)
        && validName(request.resource.data.nameLower);
      allow delete: if isOwner(ownerUid);
    }

    // What a player shares with friends. See js/profile.js for how it is built.
    match /sharedStats/{ownerUid} {
      allow read: if signedIn() && (request.auth.uid == ownerUid || areFriends(ownerUid));
      allow create, update: if isOwner(ownerUid) && validShared(request.resource.data);
      allow delete: if isOwner(ownerUid);
    }

    // Friend requests and friendships. Only the two people involved can see one.
    match /friendships/{pair} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['users', 'requestedBy', 'status', 'names'])
        && request.resource.data.keys().hasAll(['users', 'requestedBy', 'status', 'names'])
        && request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] < request.resource.data.users[1]
        && request.auth.uid in request.resource.data.users
        && pair == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.names is map;

      // Only the person who was asked can accept, and nothing else may change.
      allow update: if signedIn()
        && request.auth.uid in resource.data.users
        && request.auth.uid != resource.data.requestedBy
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      // Either person can decline, cancel or remove.
      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    // Daily results: create-only, one per player per day. The player id is read from the path so
    // that asking for a friend who has not played yet answers "not found" instead of "denied".
    // The honour system applies: the rules check shape and arithmetic, not that the shots replay.
    match /dailyScores/{scoreId} {
      allow get: if signedIn()
        && (scoreId.split('_')[1] == request.auth.uid || areFriends(scoreId.split('_')[1]));
      allow create: if signedIn()
        && scoreId == request.resource.data.date + '_' + request.auth.uid
        && validScore(request.resource.data);
    }

    // Per-day histogram: { n: players, b<total>: players with that total }. A write may only add
    // exactly one player to exactly the writer's own bucket, in the same batch as their result.
    match /dailyStats/{date} {
      allow read: if signedIn();

      allow create: if statsWriteOk(date)
        && request.resource.data.keys().hasOnly(['n', statsKey(date)])
        && request.resource.data.n == 1
        && request.resource.data[statsKey(date)] == 1;

      allow update: if statsWriteOk(date)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n', statsKey(date)])
        && request.resource.data.n == resource.data.n + 1
        && request.resource.data[statsKey(date)] == resource.data.get(statsKey(date), 0) + 1;
    }
  }
}
